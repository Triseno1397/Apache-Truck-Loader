# Supabase - fill these in from your Supabase project's API settings.
# Dashboard: https://supabase.com/dashboard/project/_/settings/api-keys
#
# Supabase rolled out a new key format. We use the new names:
#   NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY  (replaces the old anon key, starts with sb_publishable_)
#   SUPABASE_SECRET_KEY                   (replaces the old service_role key, starts with sb_secret_)
#
# NEVER commit a real .env.local. Only the publishable key is safe to expose
# to the browser; the secret key is server-only and grants full admin access.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
