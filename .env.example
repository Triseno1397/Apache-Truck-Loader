# Supabase - server-side only. The publishable key is no longer used in
# Phase 1; all DB access happens via the admin client with the secret key.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# Phase-1 shared login (no per-user identity).
# Anyone with these credentials can use the tool. Change before sharing
# beyond your trusted circle.
APP_USERNAME=admin
APP_PASSWORD=admin

# 32 random bytes hex-encoded. Generate with:
#   openssl rand -hex 32
# Changing SESSION_SECRET invalidates every existing login (forces re-login).
SESSION_SECRET=change-me-generate-a-random-64-char-hex-string
